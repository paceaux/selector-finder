{
    "env": {
        "browser": false,
        "es2022": true
    },
    "extends": ["airbnb-base", "plugin:jsdoc/recommended"],
    "plugins": ["jsdoc"],
    "parserOptions": {
        "ecmaVersion": 12
    },
    "globals": {
        "process": true,
        "describe": true,
        "test" : true,
        "expect": true,
        "beforeAll": true,
        "afterAll": true
    },
    "rules": {
        "import/extensions": "off",
        "jsdoc/no-defaults": 0
    }
}
